+
+describe("wordFrequencies", () => {
+  test("most frequent first, ties in first-appearance order", () => {
+    expect(wordFrequencies("b a b c a b")).toEqual([
+      { word: "b", count: 3 },
+      { word: "a", count: 2 },
+      { word: "c", count: 1 },
+    ]);
+  });
+  test("strips surrounding punctuation only", () => {
+    expect(wordFrequencies('"Hi," don\'t — well-known.')).toEqual([
+      { word: "Hi", count: 1 },
+      { word: "don't", count: 1 },
+      { word: "well-known", count: 1 },
+    ]);
+  });
+  test("case sensitivity", () => {
+    expect(wordFrequencies("A a").map((f) => f.word)).toEqual(["A", "a"]);
+    expect(wordFrequencies("A a", { ignoreCase: true })).toEqual([{ word: "a", count: 2 }]);
+  });
+  test("empty text", () => expect(wordFrequencies(" ... ")).toEqual([]));
+  test("freq command", () => {
+    expect(run(["freq", "a", "b", "b"])).toBe("2 b\n1 a");
+    expect(run(["freq", "--ignore-case", "--top", "1", "A", "a", "b"])).toBe("2 a");
+    expect(run(["freq"])).toBe("");
+    expect(() => run(["freq", "--top", "0", "a"])).toThrow(RangeError);
