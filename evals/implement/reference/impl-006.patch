+function formatFrequencies(args: string[]): string {
+  let top = Number.POSITIVE_INFINITY;
+  let ignoreCase = false;
+  let rest = args;
+  for (;;) {
+    const [flag, ...tail] = rest;
+    if (flag === "--ignore-case") {
+      ignoreCase = true;
+      rest = tail;
+    } else if (flag === "--top") {
+      const [value, ...words] = tail;
+      top = Number(value);
+      if (!Number.isInteger(top) || top < 1)
+        throw new RangeError("--top must be a positive integer");
+      rest = words;
+    } else break;
+  }
+  return wordFrequencies(rest.join(" "), { ignoreCase })
+    .slice(0, top)
+    .map(({ word, count }) => `${count} ${word}`)
+    .join("\n");
+}
