diff --git a/src/text.ts b/src/text.ts
index f750a49..a7bfe23 100644
--- a/src/text.ts
+++ b/src/text.ts
@@ -72,3 +72,28 @@ export function stripPunctuation(text: string): string {
     .replace(/\s+/g, " ")
     .trim();
 }
+
+export interface WordFrequency {
+  word: string;
+  count: number;
+}
+
+/**
+ * Count words, most frequent first; ties keep the order in which words first appear.
+ * Leading and trailing punctuation is ignored ("Hello," counts as "Hello"); inner punctuation
+ * such as apostrophes and hyphens is kept.
+ */
+export function wordFrequencies(
+  text: string,
+  options: { ignoreCase?: boolean } = {},
+): WordFrequency[] {
+  const counts = new Map<string, number>();
+  for (const token of text.split(/\s+/)) {
+    let word = token.replace(/^[^\p{L}\p{N}]+|[^\p{L}\p{M}\p{N}]+$/gu, "");
+    if (!word) continue;
+    if (options.ignoreCase) word = word.toLowerCase();
+    counts.set(word, (counts.get(word) ?? 0) + 1);
+  }
+  // Array.prototype.sort is stable, so equal counts stay in first-appearance order.
+  return [...counts].map(([word, count]) => ({ word, count })).sort((a, b) => b.count - a.count);
+}
