diff --git a/src/text.ts b/src/text.ts
index f750a49..714bc1d 100644
--- a/src/text.ts
+++ b/src/text.ts
@@ -72,3 +72,24 @@ export function stripPunctuation(text: string): string {
     .replace(/\s+/g, " ")
     .trim();
 }
+
+/**
+ * Greedily wrap text into lines of at most `width` characters. Any whitespace separates words;
+ * a word longer than `width` is kept whole on its own line.
+ */
+export function wrap(text: string, width = 80): string {
+  if (!Number.isInteger(width) || width < 1)
+    throw new RangeError("width must be a positive integer");
+  const lines: string[] = [];
+  let line = "";
+  for (const word of text.split(/\s+/)) {
+    if (!word) continue;
+    if (line && line.length + 1 + word.length <= width) line += ` ${word}`;
+    else {
+      if (line) lines.push(line);
+      line = word;
+    }
+  }
+  if (line) lines.push(line);
+  return lines.join("\n");
+}
