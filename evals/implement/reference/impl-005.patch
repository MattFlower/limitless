+
+describe("wrap", () => {
+  test("greedy lines within the width", () => {
+    expect(wrap("The quick brown fox jumps", 10)).toBe("The quick\nbrown fox\njumps");
+  });
+  test("long words stay whole", () => expect(wrap("a abcdefgh b", 4)).toBe("a\nabcdefgh\nb"));
+  test("empty text", () => expect(wrap("  \n ")).toBe(""));
+  test("rejects bad widths", () => {
+    for (const width of [0, -1, 1.5, NaN]) expect(() => wrap("x", width)).toThrow(RangeError);
+  });
+  test("wrap command", () => {
+    expect(run(["wrap", "--width", "3", "a", "b", "c"])).toBe("a b\nc");
+    expect(run(["wrap", "a", "b"])).toBe("a b");
+    expect(() => run(["wrap", "--width", "x", "a"])).toThrow(RangeError);
+  });
+  test("wrap usage", () => expect(run([])).toContain("wrap [--width N] <text>"));
+});
