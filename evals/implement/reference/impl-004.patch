+/**
+ * Capitalize the first letter of every word. A letter starts a word unless it follows a letter,
+ * combining mark, digit or apostrophe: "café" and "don't" stay one word, "well-known" is two.
+ */
 export function titleCase(text: string): string {
-  return text.replace(/\b\p{L}/gu, (c) => c.toUpperCase());
+  return text.replace(/(?<![\p{L}\p{M}\p{N}'’])\p{L}/gu, (c) => c.toUpperCase());
 }
 
 /** Remove punctuation and normalize whitespace while preserving other characters. */
