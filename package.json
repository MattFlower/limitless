{
  "name": "limitless",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal autonomous software factory",
  "bin": {
    "limitless": "./src/cli/main.ts"
  },
  "scripts": {
    "dev": "bun --watch src/cli/main.ts serve",
    "serve": "bun src/cli/main.ts serve",
    "build:ui": "bun scripts/build-ui.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@solidjs/router": "^1.0.0",
    "discord.js": "^14.27.0",
    "solid-js": "^1.9.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-typescript": "^8.0.1",
    "@biomejs/biome": "^2.5.14",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.2",
    "babel-preset-solid": "^1.9.15",
    "typescript": "^7.0.2"
  }
}
